# Clip2Post Environment Variables Configuration

# OpenAI / DeepSeek API settings
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
LLM_MODEL=""

# ASR (Automatic Speech Recognition) Model Settings
# Options: "funasr", "faster-whisper", "whisperx"
ASR_TYPE="funasr"

# FunASR Settings
ASR_MODEL_DIR="iic/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-pytorch"

# Whisper / WhisperX Settings
WHISPER_MODEL_SIZE="large-v3"
# Device options: "cpu", "cuda", "mps"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="float32"
# 允许指定本地模型路径（如从魔塔下载到 models 目录下的路径）
# WHISPER_MODEL_PATH="models/whisper-large-v3"
WHISPER_MODEL_PATH=""

# Hugging Face Token (Required for WhisperX VAD model)
# Obtain from: https://huggingface.co/settings/tokens
HF_TOKEN=""

# Hugging Face Mirror (Optional, for region-restricted or slow connections)
# Example: https://hf-mirror.com
HF_ENDPOINT="https://hf-mirror.com"

# MiMo API Settings
LLM_VENDOR=mimo
MIMO_API_KEY=your_mimo_api_key
MINIMAX_API_KEY=your_minimax_api_key

# LLM_VENDOR = direct
LLM_API_KEY=your_api_key
LLM_BASE_URL=your_base_url
LLM_MODEL=your_model

# Remotion 视频生成模式: "overwrite" (覆盖模式/全量重写) 或 "chunkdiff" (分块差分模式/修补续写)
REMOTION_GEN_MODE="chunkdiff"

# TTS Defaults
DEFAULT_TTS_ENGINE="omnivoice"
DEFAULT_TTS_VOICE="男，老年"

# Bot Specific LLM Configuration (Topic Script Generation)
BOT_OPENAI_API_KEY="your_bot_api_key_here"
BOT_OPENAI_BASE_URL="https://api.openai.com/v1"
BOT_LLM_MODEL="gpt-4-turbo"

# Media Defaults
DEFAULT_BGM="bgm/default_jazz.mp3"
DEFAULT_BG="image.png"

# Feishu Bot Configurations
LARK_APP_ID="cli_xxxxxxxxxxxx"
LARK_APP_SECRET="xxxxxxxxxxxxxxxxxxxx"
LARK_ENCRYPT_KEY="xxxxxxxxxxxxxxxxxxxx"
LARK_VERIFICATION_TOKEN="xxxxxxxxxxxxxxxxxxxx"
TOPIC_CONFIRM_CARD_ID="ct_xxxxxxxxxxxx"
DISTRIBUTE_CARD_ID="ct_xxxxxxxxxxxx"